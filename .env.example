# Local configuration for CharArchive.
# Copy this file to ".env" only if you need to change the defaults below.
# The AI API key does NOT go here anymore - set it inside the app under
# Developer & Settings > AI Engine Settings, and it is stored on this computer
# in chararchive.config.json (which is excluded from git).

# Port the local server listens on.
PORT=3000

# Interface to bind. Leave as 127.0.0.1 so only this computer can reach the
# archive and Windows Firewall does not prompt for network access.
HOST=127.0.0.1

# Set to "production" when running the built app instead of the dev server.
NODE_ENV=production